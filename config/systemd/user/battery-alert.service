[Unit]
Description=Battery Level & Discharge Alert Notification Daemon
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/bin/bash /home/Krish/.config/hypr/scripts/battery-alert.sh
Restart=on-failure
