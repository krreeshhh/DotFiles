# ==========================================
# My-Desktop Wallpaper & Theme Configuration
# ==========================================

# Directory containing wallpapers (supports .jpg, .jpeg, .png, .webp)
WALLPAPER_DIR="${WALLPAPER_DIR:-$HOME/.wallpaper}"

# Default wallpaper fallback if none selected yet
DEFAULT_WALLPAPER="${DEFAULT_WALLPAPER:-$HOME/.wallpaper/Wall.png}"

# Wallpaper backend: "awww" (supports transitions) or "swaybg" (static fallback)
WALLPAPER_BACKEND="awww"

# Scaling mode: crop (fill), fit, stretch, no
WALLPAPER_MODE="crop"

# Transition Animation Settings (for awww / swww)
# Transition types: grow, wave, wipe, disc, outer, simple, fade, random
TRANSITION_TYPE="grow"

# Transition origin position: "center", "cursor" (dynamic click position), "top", "bottom", "left", "right"
TRANSITION_POS="cursor"

# Transition duration in seconds (e.g. 1.2, 1.5, 2.0)
TRANSITION_DURATION="1.4"

# Transition Framerate (matched to refresh rate e.g. 60, 120, 144)
TRANSITION_FPS="144"

# Transition Easing Curve (Material You smooth cubic-bezier)
TRANSITION_BEZIER=".25,1,.5,1"

# Transition step (smoothing intensity, default 90)
TRANSITION_STEP="90"

# State & Cache Paths
STATE_FILE="$HOME/.config/my-desktop/wallpaper/current"
CACHE_DIR="$HOME/.cache/my-desktop/thumbnails"

# Dynamic Material You Theme Extraction (true / false)
ENABLE_DYNAMIC_THEME=true
