{
  "manifest_version": 3,
  "name": "Hypr PiP - Universal Picture-in-Picture",
  "version": "1.0.0",
  "description": "Smart, native Picture-in-Picture with Alt+P shortcut designed for Hyprland desktop.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Hypr PiP (Alt+P)"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-pip": {
      "suggested_key": {
        "default": "Alt+P"
      },
      "description": "Toggle Picture-in-Picture for currently playing video"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "hypr-pip@hyprland.desktop",
      "strict_min_version": "109.0"
    }
  }
}
