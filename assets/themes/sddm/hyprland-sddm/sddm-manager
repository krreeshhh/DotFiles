#!/usr/bin/env bash
# ==============================================================================
# sddm-manager - Intelligent Manager for SilentSDDM Greeter Theme
# Dynamic Wallpapers, Reverse-Blur Control, Testing & Diagnostics
# ==============================================================================
set -euo pipefail

THEME_SRC_DIR="/home/Krish/SilentSDDM"
SYSTEM_THEMES_DIR="/usr/share/sddm/themes"
INSTALLED_THEME_DIR="$SYSTEM_THEMES_DIR/silent"
WALLPAPER_DIR="/home/Krish/.wallpaper"
CONFIG_FILE="$THEME_SRC_DIR/configs/default.conf"
ASKPASS="/home/Krish/.local/bin/mechanic-askpass"

# ANSI Colors
BOLD='\033[1m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
PURPLE='\033[0;35m'
GREY='\033[0;90m'
NC='\033[0m' # No Color

run_sudo() {
    if [ "$EUID" -eq 0 ]; then
        "$@"
    elif sudo -n true 2>/dev/null; then
        sudo "$@"
    elif [ -x "$ASKPASS" ]; then
        SUDO_ASKPASS="$ASKPASS" sudo -A "$@"
    else
        sudo "$@"
    fi
}

cmd_help() {
    echo -e "${BOLD}${CYAN}SilentSDDM Manager (${PURPLE}sddm-manager${CYAN})${NC}"
    echo -e "Unified management tool for Silent SDDM with dynamic wallpaper autorefresh & reverse blur\n"
    echo -e "${BOLD}Usage:${NC} sddm-manager [command] [options]\n"
    echo -e "${BOLD}Commands:${NC}"
    echo -e "  ${GREEN}test${NC}, ${GREEN}preview${NC}        Launch theme in test-mode with greeter window"
    echo -e "  ${GREEN}randomize${NC}, ${GREEN}next${NC}       Instantly pick and apply a new random wallpaper from ~/.wallpaper"
    echo -e "  ${GREEN}set${NC} <file|name>      Set a specific wallpaper from ~/.wallpaper or absolute path"
    echo -e "  ${GREEN}list${NC}                 List all available wallpapers in ~/.wallpaper"
    echo -e "  ${GREEN}status${NC}               Display greeter configuration, blur state, and active wallpaper"
    echo -e "  ${GREEN}install${NC}              Install/update theme in /usr/share/sddm/themes/silent and activate"
    echo -e "  ${GREEN}setup-acl${NC}            Configure file ACLs so SDDM greeter can read ~/.wallpaper"
    echo -e "  ${GREEN}reverse-blur${NC}         Verify or toggle reversed blur (clear lock screen / blurred login)"
    echo -e "  ${GREEN}help${NC}                 Show this help manual\n"
}

cmd_status() {
    echo -e "${BOLD}${CYAN}=== SilentSDDM Status ===${NC}"
    
    # Active SDDM theme
    local current_theme="unknown"
    if [ -f /etc/sddm.conf.d/theme.conf ]; then
        current_theme=$(grep -E '^Current=' /etc/sddm.conf.d/theme.conf 2>/dev/null | cut -d'=' -f2 || echo "unknown")
    elif [ -f /etc/sddm.conf ]; then
        current_theme=$(grep -E '^Current=' /etc/sddm.conf 2>/dev/null | cut -d'=' -f2 || echo "unknown")
    fi
    echo -e "${BOLD}Active SDDM Theme:${NC}     ${GREEN}${current_theme}${NC}"
    
    # Installed directory
    if [ -d "$INSTALLED_THEME_DIR" ]; then
        echo -e "${BOLD}Theme Installation:${NC}    ${GREEN}Installed at $INSTALLED_THEME_DIR${NC}"
    else
        echo -e "${BOLD}Theme Installation:${NC}    ${YELLOW}Not installed in /usr/share/sddm/themes/silent${NC}"
    fi

    # Blur configuration
    local lock_blur="32"
    local login_blur="0"
    if [ -f "$CONFIG_FILE" ]; then
        lock_blur=$(awk '/^\[LockScreen\]/{flag=1;next}/^\[/{flag=0}flag && /^blur = /{print $3}' "$CONFIG_FILE" || echo "32")
        login_blur=$(awk '/^\[LoginScreen\]/{flag=1;next}/^\[/{flag=0}flag && /^blur = /{print $3}' "$CONFIG_FILE" || echo "0")
    fi
    echo -e "${BOLD}LockScreen Blur:${NC}       ${CYAN}${lock_blur}px${NC} $([ "$lock_blur" = "0" ] && echo -e "(${GREEN}Clear background${NC})" || echo -e "(${YELLOW}Blurred${NC})")"
    echo -e "${BOLD}LoginScreen Blur:${NC}      ${CYAN}${login_blur}px${NC} $([ "$login_blur" != "0" ] && echo -e "(${GREEN}Frosted blur on password entry${NC})" || echo -e "(${YELLOW}Clear${NC})")"
    if [ "$lock_blur" = "0" ] && [ "$login_blur" != "0" ]; then
        echo -e "${BOLD}Reverse Blur Mode:${NC}     ${GREEN}ACTIVE${NC} (Clear on start -> Blur on password entry)"
    else
        echo -e "${BOLD}Reverse Blur Mode:${NC}     ${YELLOW}STANDARD / INACTIVE${NC}"
    fi

    # Wallpapers
    if [ -d "$WALLPAPER_DIR" ]; then
        local wp_count
        wp_count=$(find "$WALLPAPER_DIR" -maxdepth 1 -type f \( -name "*.png" -o -name "*.jpg" -o -name "*.jpeg" -o -name "*.webp" \) | wc -l)
        echo -e "${BOLD}Wallpaper Source:${NC}      ${CYAN}$WALLPAPER_DIR${NC} (${GREEN}${wp_count} wallpapers found${NC})"
    else
        echo -e "${BOLD}Wallpaper Source:${NC}      ${RED}Directory $WALLPAPER_DIR not found${NC}"
    fi

    # ACL Check
    if getfacl "$WALLPAPER_DIR" 2>/dev/null | grep -q "user:sddm:r-x"; then
        echo -e "${BOLD}SDDM User ACL:${NC}         ${GREEN}Configured (sddm user has read access)${NC}"
    else
        echo -e "${BOLD}SDDM User ACL:${NC}         ${YELLOW}Missing (run 'sddm-manager setup-acl')${NC}"
    fi

    # SDDM daemon status
    if systemctl is-active --quiet sddm; then
        echo -e "${BOLD}SDDM Daemon:${NC}           ${GREEN}Active & Running${NC}"
    else
        echo -e "${BOLD}SDDM Daemon:${NC}           ${YELLOW}Inactive${NC}"
    fi
    echo ""
}

cmd_list() {
    echo -e "${BOLD}${CYAN}Available Wallpapers in $WALLPAPER_DIR:${NC}"
    local count=0
    while IFS= read -r -d $'\0' file; do
        count=$((count + 1))
        local bname
        bname=$(basename "$file")
        local fsize
        fsize=$(du -h "$file" | cut -f1)
        printf "  ${GREEN}%2d.${NC} %-35s ${GREY}(%s)${NC}\n" "$count" "$bname" "$fsize"
    done < <(find "$WALLPAPER_DIR" -maxdepth 1 -type f \( -name "*.png" -o -name "*.jpg" -o -name "*.jpeg" -o -name "*.webp" \) -print0 | sort -z)
    echo -e "\nTotal: ${BOLD}${count}${NC} wallpapers"
}

cmd_setup_acl() {
    echo -e "${CYAN}-> Configuring POSIX ACLs for sddm user on $WALLPAPER_DIR...${NC}"
    setfacl -m u:sddm:rx /home/Krish
    setfacl -R -m u:sddm:rx "$WALLPAPER_DIR"
    setfacl -R -d -m u:sddm:rx "$WALLPAPER_DIR"
    echo -e "${GREEN}✓ SDDM user now has traversal and read permissions on $WALLPAPER_DIR.${NC}"
}

cmd_randomize() {
    if [ ! -d "$WALLPAPER_DIR" ]; then
        echo -e "${RED}Error: Wallpaper directory $WALLPAPER_DIR does not exist!${NC}" >&2
        return 1
    fi

    local chosen
    chosen=$(find "$WALLPAPER_DIR" -maxdepth 1 -type f \( -name "*.png" -o -name "*.jpg" -o -name "*.jpeg" -o -name "*.webp" \) | shuf -n 1)

    if [ -z "$chosen" ] || [ ! -f "$chosen" ]; then
        echo -e "${RED}Error: No wallpapers found in $WALLPAPER_DIR!${NC}" >&2
        return 1
    fi

    local wp_name
    wp_name=$(basename "$chosen")
    echo -e "${CYAN}-> Selected random wallpaper:${NC} ${GREEN}${wp_name}${NC}"

    # Cache in theme backgrounds if writable or with sudo
    mkdir -p "$THEME_SRC_DIR/backgrounds"
    cp -f "$chosen" "$THEME_SRC_DIR/backgrounds/current.png"

    if [ -d "$INSTALLED_THEME_DIR/backgrounds" ]; then
        if [ -w "$INSTALLED_THEME_DIR/backgrounds/current.png" ] || [ -w "$INSTALLED_THEME_DIR/backgrounds" ]; then
            cp -f "$chosen" "$INSTALLED_THEME_DIR/backgrounds/current.png"
            chmod 666 "$INSTALLED_THEME_DIR/backgrounds/current.png" 2>/dev/null || true
        else
            run_sudo cp -f "$chosen" "$INSTALLED_THEME_DIR/backgrounds/current.png"
            run_sudo chmod 666 "$INSTALLED_THEME_DIR/backgrounds/current.png" 2>/dev/null || true
        fi
    fi

    echo -e "${GREEN}✓ Successfully set active wallpaper to:${NC} ${BOLD}$wp_name${NC}"
}

cmd_set() {
    local target="${1:-}"
    if [ -z "$target" ]; then
        echo -e "${RED}Usage: sddm-manager set <filename or path>${NC}" >&2
        return 1
    fi

    local resolved=""
    if [ -f "$target" ]; then
        resolved="$target"
    elif [ -f "$WALLPAPER_DIR/$target" ]; then
        resolved="$WALLPAPER_DIR/$target"
    else
        # Try fuzzy match
        local match
        match=$(find "$WALLPAPER_DIR" -maxdepth 1 -iname "*$target*" -type f | head -n 1)
        if [ -n "$match" ] && [ -f "$match" ]; then
            resolved="$match"
        fi
    fi

    if [ -z "$resolved" ] || [ ! -f "$resolved" ]; then
        echo -e "${RED}Error: Could not find wallpaper matching '$target'!${NC}" >&2
        return 1
    fi

    local wp_name
    wp_name=$(basename "$resolved")
    echo -e "${CYAN}-> Applying wallpaper:${NC} ${GREEN}${wp_name}${NC}"

    mkdir -p "$THEME_SRC_DIR/backgrounds"
    cp -f "$resolved" "$THEME_SRC_DIR/backgrounds/current.png"

    if [ -d "$INSTALLED_THEME_DIR/backgrounds" ]; then
        if [ -w "$INSTALLED_THEME_DIR/backgrounds/current.png" ] || [ -w "$INSTALLED_THEME_DIR/backgrounds" ]; then
            cp -f "$resolved" "$INSTALLED_THEME_DIR/backgrounds/current.png"
            chmod 666 "$INSTALLED_THEME_DIR/backgrounds/current.png" 2>/dev/null || true
        else
            run_sudo cp -f "$resolved" "$INSTALLED_THEME_DIR/backgrounds/current.png"
            run_sudo chmod 666 "$INSTALLED_THEME_DIR/backgrounds/current.png" 2>/dev/null || true
        fi
    fi

    echo -e "${GREEN}✓ Active wallpaper updated to:${NC} ${BOLD}$wp_name${NC}"
}

cmd_reverse_blur() {
    local mode="${1:-status}"
    case "$mode" in
        enable|on)
            sed -i '/^\[LockScreen\]/,/^\[/ s/^blur = .*/blur = 0/' "$CONFIG_FILE"
            sed -i '/^\[LoginScreen\]/,/^\[/ s/^blur = .*/blur = 32/' "$CONFIG_FILE"
            echo -e "${GREEN}✓ Reverse blur ENABLED: LockScreen blur=0, LoginScreen blur=32.${NC}"
            ;;
        disable|off)
            sed -i '/^\[LockScreen\]/,/^\[/ s/^blur = .*/blur = 32/' "$CONFIG_FILE"
            sed -i '/^\[LoginScreen\]/,/^\[/ s/^blur = .*/blur = 0/' "$CONFIG_FILE"
            echo -e "${YELLOW}✓ Default blur RESTORED: LockScreen blur=32, LoginScreen blur=0.${NC}"
            ;;
        status|*)
            cmd_status
            ;;
    esac
}

cmd_test() {
    echo -e "${BOLD}${CYAN}Launching SilentSDDM in test-mode...${NC}"
    echo -e "${GREY}Press any key or click to transition from start screen (clear) to login screen (blurred).${NC}"
    echo -e "${GREY}Press Escape on login screen to return to start screen.${NC}"
    echo -e "${GREY}Press F5 on start screen to instantly shuffle wallpaper.${NC}"
    echo -e "${GREY}Close the window or press Ctrl+C to exit test mode.${NC}\n"

    cd "$THEME_SRC_DIR"
    QT_IM_MODULE=qtvirtualkeyboard QML2_IMPORT_PATH="./components/" sddm-greeter-qt6 --test-mode --theme .
}

cmd_install() {
    echo -e "${BOLD}${CYAN}=== Installing SilentSDDM Theme ===${NC}"

    # 1. Setup ACLs
    cmd_setup_acl

    # 2. Randomize initial current.png
    cmd_randomize || true

    # 3. Copy theme files to /usr/share/sddm/themes/silent
    echo -e "${CYAN}-> Copying theme files to $INSTALLED_THEME_DIR...${NC}"
    run_sudo mkdir -p "$INSTALLED_THEME_DIR"
    run_sudo cp -rf "$THEME_SRC_DIR"/* "$INSTALLED_THEME_DIR/"
    run_sudo chmod -R 755 "$INSTALLED_THEME_DIR"

    # Make background writable for seamless live syncing
    if [ -f "$INSTALLED_THEME_DIR/backgrounds/current.png" ]; then
        run_sudo chmod 666 "$INSTALLED_THEME_DIR/backgrounds/current.png"
    fi

    # 4. Copy bundled fonts
    echo -e "${CYAN}-> Installing Red Hat fonts to /usr/share/fonts/...${NC}"
    run_sudo mkdir -p /usr/share/fonts/redhat
    run_sudo cp -rf "$THEME_SRC_DIR/fonts/redhat/"* /usr/share/fonts/redhat/ 2>/dev/null || true
    if [ -d "$THEME_SRC_DIR/fonts/redhat-vf" ]; then
        run_sudo mkdir -p /usr/share/fonts/redhat-vf
        run_sudo cp -rf "$THEME_SRC_DIR/fonts/redhat-vf/"* /usr/share/fonts/redhat-vf/ 2>/dev/null || true
    fi
    fc-cache -f /usr/share/fonts/redhat /usr/share/fonts/redhat-vf 2>/dev/null || true

    # 5. Configure SDDM configuration
    echo -e "${CYAN}-> Configuring /etc/sddm.conf.d/...${NC}"
    run_sudo mkdir -p /etc/sddm.conf.d

    cat <<EOF | run_sudo tee /etc/sddm.conf.d/silent.conf >/dev/null
[Theme]
Current=silent

[General]
InputMethod=qtvirtualkeyboard
GreeterEnvironment=QML2_IMPORT_PATH=/usr/share/sddm/themes/silent/components/,QT_IM_MODULE=qtvirtualkeyboard
EOF

    cat <<EOF | run_sudo tee /etc/sddm.conf.d/theme.conf >/dev/null
[Theme]
Current=silent
EOF

    # 6. Configure Xsetup for auto-randomization on boot/display launch
    echo -e "${CYAN}-> Configuring /usr/share/sddm/scripts/Xsetup for automatic boot randomizer...${NC}"
    cat <<'EOF' | run_sudo tee /usr/share/sddm/scripts/Xsetup >/dev/null
#!/bin/sh
# Xsetup - run as root before the login dialog appears

# Auto-randomize SilentSDDM wallpaper on greeter start
WALLPAPERS_DIR="/home/Krish/.wallpaper"
THEME_DIR="/usr/share/sddm/themes/silent"

if [ -d "$WALLPAPERS_DIR" ] && [ -d "$THEME_DIR/backgrounds" ]; then
    RANDOM_BG=$(find "$WALLPAPERS_DIR" -maxdepth 1 -type f \( -name "*.png" -o -name "*.jpg" -o -name "*.jpeg" -o -name "*.webp" \) 2>/dev/null | shuf -n 1)
    if [ -n "$RANDOM_BG" ] && [ -f "$RANDOM_BG" ]; then
        cp -f "$RANDOM_BG" "$THEME_DIR/backgrounds/current.png" 2>/dev/null || true
        chmod 666 "$THEME_DIR/backgrounds/current.png" 2>/dev/null || true
    fi
fi
EOF
    run_sudo chmod +x /usr/share/sddm/scripts/Xsetup

    # 7. Update apply-wallpaper.sh hook
    local apply_wp="/home/Krish/.config/my-desktop/wallpaper/apply-wallpaper.sh"
    if [ -f "$apply_wp" ]; then
        echo -e "${CYAN}-> Updating desktop wallpaper sync hook in apply-wallpaper.sh...${NC}"
        sed -i 's|/usr/share/sddm/themes/hyprland-sddm/background.png|/usr/share/sddm/themes/silent/backgrounds/current.png|g' "$apply_wp"
    fi

    # 8. Install symlink in /usr/local/bin for global access
    echo -e "${CYAN}-> Registering sddm-manager in /usr/local/bin/sddm-manager...${NC}"
    run_sudo ln -sf "$THEME_SRC_DIR/sddm-manager" /usr/local/bin/sddm-manager
    mkdir -p /home/Krish/.local/bin
    ln -sf "$THEME_SRC_DIR/sddm-manager" /home/Krish/.local/bin/sddm-manager

    echo -e "\n${BOLD}${GREEN}✔ SilentSDDM successfully installed and configured as active SDDM theme!${NC}"
    echo -e "You can manage, test, and shuffle wallpapers at any time with '${PURPLE}sddm-manager${NC}'.\n"
}

# Subcommand dispatch
ACTION="${1:-status}"
shift || true

case "$ACTION" in
    test|preview)
        cmd_test "$@"
        ;;
    randomize|next|shuffle)
        cmd_randomize "$@"
        ;;
    set)
        cmd_set "$@"
        ;;
    list|ls)
        cmd_list "$@"
        ;;
    status)
        cmd_status "$@"
        ;;
    reverse-blur|blur)
        cmd_reverse_blur "$@"
        ;;
    setup-acl|acl)
        cmd_setup_acl "$@"
        ;;
    install)
        cmd_install "$@"
        ;;
    help|--help|-h)
        cmd_help
        ;;
    *)
        echo -e "${RED}Unknown command: $ACTION${NC}\n" >&2
        cmd_help
        exit 1
        ;;
esac
