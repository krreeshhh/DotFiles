# Allow users to control ASUS keyboard backlight without root privileges
SUBSYSTEM=="leds", KERNEL=="asus::kbd_backlight", ACTION=="add|change", RUN+="/bin/chmod 0666 /sys/class/leds/asus::kbd_backlight/brightness /sys/class/leds/asus::kbd_backlight/kbd_rgb_mode /sys/class/leds/asus::kbd_backlight/kbd_rgb_state"
