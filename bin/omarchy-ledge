#!/usr/bin/env bash
# omarchy-ledge — command line front end for the Ledge plugin in Quickshell.

set -euo pipefail

IPC_TARGET="bylund.ledge"
VERSION="0.2.0"

die() {
  printf 'omarchy-ledge: %s\n' "$1" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage: omarchy-ledge <command> [arguments]

Commands:
  add [--no-show] <file>...  Put files on the ledge (opens the ledge)
  pin <file>...              Pin files so clear leaves them (adds if needed)
  unpin <file>...            Unpin files so clear can take them
  list                       Print the files currently on the ledge
  count                      Print how many files are on the ledge
  clear                      Remove everything unpinned from the ledge
  show | toggle | hide       Open or close the ledge under its bar icon
  help | version

Examples:
  omarchy-ledge add ~/Pictures/screenshot.png
  omarchy-ledge add --no-show ./report.pdf ../notes.md
  omarchy-ledge list | wl-copy
EOF
}

ledge() {
  quickshell ipc call "$IPC_TARGET" "$@" ||
    die "the ledge did not answer — is Quickshell running with LedgeWidget on the bar?"
}

json_escape() {
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\t'/\\t}
  s=${s//$'\r'/\\r}
  s=${s//$'\n'/\\n}
  printf '"%s"' "$s"
}

json_payload() {
  local out="" item
  for item in "$@"; do
    if [ -n "$out" ]; then
      out+=","
    fi
    out+=$(json_escape "$item")
  done
  printf '{"paths":[%s]}' "$out"
}

cmd_add() {
  local show=1
  local files=()

  while [ $# -gt 0 ]; do
    case $1 in
      --no-show | -n)
        show=0
        shift
        ;;
      --)
        shift
        break
        ;;
      -*)
        die "unknown option: $1"
        ;;
      *)
        break
        ;;
    esac
  done

  [ $# -gt 0 ] || die "add needs at least one file"

  local file abs
  for file in "$@"; do
    [ -e "$file" ] || die "no such file: $file"
    abs=$(realpath -- "$file")
    files+=("$abs")
  done

  local payload
  payload=$(json_payload "${files[@]}")

  if [ "$show" -eq 1 ]; then
    ledge add "$payload" >/dev/null
  else
    ledge addQuiet "$payload" >/dev/null
  fi
}

cmd_pin() {
  local action=$1
  shift

  [ $# -gt 0 ] || die "$action needs at least one file"

  local files=()
  local file abs
  for file in "$@"; do
    [ -e "$file" ] || die "no such file: $file"
    abs=$(realpath -- "$file")
    files+=("$abs")
  done

  local payload
  payload=$(json_payload "${files[@]}")
  ledge "$action" "$payload" >/dev/null
}

main() {
  local subcommand=${1:-help}
  if [ $# -gt 0 ]; then
    shift
  fi

  case $subcommand in
    add)
      cmd_add "$@"
      ;;
    pin | unpin)
      cmd_pin "$subcommand" "$@"
      ;;
    list)
      ledge list
      ;;
    count)
      ledge count
      ;;
    clear)
      ledge clear >/dev/null
      ;;
    show | toggle | hide)
      ledge "$subcommand"
      ;;
    help | --help | -h)
      usage
      ;;
    version | --version | -v)
      printf 'omarchy-ledge %s\n' "$VERSION"
      ;;
    *)
      usage >&2
      die "unknown command: $subcommand"
      ;;
  esac
}

main "$@"
