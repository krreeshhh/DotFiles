#!/usr/bin/env bash
# omarchy — Unified Omarchy Command & Plugin Dispatcher

set -euo pipefail

PLUGINS_DIR="$HOME/.config/quickshell/plugins"
BAR_QML="$HOME/.config/quickshell/bar/Bar.qml"

export QML_IMPORT_PATH="$HOME/.config/quickshell:$HOME/.config/quickshell/plugins:${QML_IMPORT_PATH:-}"
export QML2_IMPORT_PATH="$HOME/.config/quickshell:$HOME/.config/quickshell/plugins:${QML2_IMPORT_PATH:-}"

mkdir -p "$PLUGINS_DIR"

reload_quickshell() {
  printf 'Reloading Quickshell...\n'
  if systemctl --user is-active quickshell.service >/dev/null 2>&1 || systemctl --user is-enabled quickshell.service >/dev/null 2>&1; then
    systemctl --user restart quickshell || true
  else
    killall -q quickshell || true
    sleep 0.2
    nohup "$HOME/.config/quickshell/launch.sh" >/dev/null 2>&1 &
  fi
}

die() {
  printf 'omarchy: %s\n' "$1" >&2
  exit 1
}

# --- Plugin Subcommand Handler ---
cmd_plugin() {
  local sub="${1:-help}"
  if [ $# -gt 0 ]; then shift; fi

  case "$sub" in
    list)
      printf '=== Installed Omarchy Plugins ===\n'
      for p in "$PLUGINS_DIR"/*/; do
        [ -d "$p" ] || continue
        local dir_name manifest name version id
        dir_name=$(basename "$p")
        manifest="$p/manifest.json"
        if [ -f "$manifest" ]; then
          name=$(python3 -c "import json; print(json.load(open('$manifest')).get('name', '$dir_name'))" 2>/dev/null || echo "$dir_name")
          version=$(python3 -c "import json; print(json.load(open('$manifest')).get('version', 'unknown'))" 2>/dev/null || echo "")
          id=$(python3 -c "import json; print(json.load(open('$manifest')).get('id', '$dir_name'))" 2>/dev/null || echo "$dir_name")
          printf '  • %s (%s) [%s] -> %s\n' "$name" "$version" "$id" "$dir_name"
        else
          printf '  • %s (no manifest)\n' "$dir_name"
        fi
      done
      ;;

    add|install)
      local enable=0
      local repo_url=""

      while [ $# -gt 0 ]; do
        case "$1" in
          --enable|-e)
            enable=1
            shift
            ;;
          *)
            repo_url="$1"
            shift
            ;;
        esac
      done

      [ -n "$repo_url" ] || die "plugin add requires a repository URL"

      # Determine plugin folder name
      local repo_name
      repo_name=$(basename "$repo_url" .git)
      local target_dir="$PLUGINS_DIR/$repo_name"

      printf '==> Installing Omarchy plugin: %s\n' "$repo_name"
      if [ -d "$target_dir/.git" ]; then
        printf 'Plugin folder exists. Updating with git pull...\n'
        git -C "$target_dir" pull --quiet || true
      else
        printf 'Cloning %s...\n' "$repo_url"
        git clone --quiet "$repo_url" "$target_dir"
      fi

      local manifest="$target_dir/manifest.json"
      if [ ! -f "$manifest" ]; then
        printf 'Warning: Plugin missing manifest.json\n'
      else
        local plugin_name
        plugin_name=$(python3 -c "import json; print(json.load(open('$manifest')).get('name', '$repo_name'))" 2>/dev/null || echo "$repo_name")
        printf '✓ Plugin "%s" installed at %s\n' "$plugin_name" "$target_dir"
      fi

      # Run custom adaptation if available (e.g. patching agents.sh for agy support)
      if [ -f "$target_dir/agents.sh" ]; then
        if ! grep -q "agy" "$target_dir/agents.sh"; then
          sed -i 's/known_agents=(\([^)]*\))/known_agents=(agy \1)/' "$target_dir/agents.sh" || true
        fi
      fi

      # Auto-patch recursive BarWidget.qml if present
      if [ -f "$target_dir/BarWidget.qml" ]; then
        if grep -E -q '^[[:space:]]*BarWidget[[:space:]]*\{' "$target_dir/BarWidget.qml"; then
          if ! grep -q 'import qs.Ui as Ui' "$target_dir/BarWidget.qml"; then
            sed -i '1i import qs.Ui as Ui' "$target_dir/BarWidget.qml"
          fi
          sed -i 's/^[[:space:]]*BarWidget[[:space:]]*{/Ui.BarWidget {/' "$target_dir/BarWidget.qml"
        fi
      fi

      if [ "$enable" -eq 1 ]; then
        cmd_plugin_enable "$repo_name"
      else
        reload_quickshell
      fi
      ;;

    enable)
      local target="${1:-}"
      [ -n "$target" ] || die "enable requires a plugin directory or ID"
      cmd_plugin_enable "$target"
      ;;

    disable)
      local target="${1:-}"
      [ -n "$target" ] || die "disable requires a plugin directory or ID"
      cmd_plugin_disable "$target"
      ;;

    remove)
      local target="${1:-}"
      [ -n "$target" ] || die "remove requires a plugin directory name"
      cmd_plugin_disable "$target" || true
      rm -rf "$PLUGINS_DIR/$target"
      printf 'Removed plugin %s\n' "$target"
      reload_quickshell
      ;;

    help|--help|-h)
      cat <<'EOF'
Usage: omarchy plugin <command> [arguments]

Commands:
  add <repo_url> [--enable]   Install a plugin from Git repository
  list                        List installed plugins
  enable <plugin_name>        Enable and mount plugin widget into the bar
  disable <plugin_name>       Disable and unmount plugin widget from the bar
  remove <plugin_name>        Remove a plugin directory
EOF
      ;;

    *)
      die "unknown plugin command: $sub"
      ;;
  esac
}

cmd_plugin_enable() {
  local target="$1"
  local plugin_dir="$PLUGINS_DIR/$target"
  if [ ! -d "$plugin_dir" ]; then
    # Search by manifest ID
    for p in "$PLUGINS_DIR"/*/; do
      if [ -f "$p/manifest.json" ]; then
        local id
        id=$(python3 -c "import json; print(json.load(open('$p/manifest.json')).get('id', ''))" 2>/dev/null || true)
        if [ "$id" = "$target" ]; then
          plugin_dir="${p%/}"
          target=$(basename "$plugin_dir")
          break
        fi
      fi
    done
  fi

  [ -d "$plugin_dir" ] || die "plugin $target not found in $PLUGINS_DIR"

  local manifest="$plugin_dir/manifest.json"
  local widget_file=""
  if [ -f "$manifest" ]; then
    widget_file=$(python3 -c "import json; print(json.load(open('$manifest')).get('entryPoints', {}).get('barWidget', ''))" 2>/dev/null || true)
  fi

  if [ -z "$widget_file" ]; then
    if [ -f "$plugin_dir/BarWidget.qml" ]; then
      widget_file="BarWidget.qml"
    elif [ -f "$plugin_dir/LedgeWidget.qml" ]; then
      widget_file="LedgeWidget.qml"
    elif [ -f "$plugin_dir/Panel.qml" ]; then
      widget_file="Panel.qml"
    fi
  fi

  local widget_name="${widget_file%.qml}"

  printf 'Enabling plugin "%s" (Widget: %s)...\n' "$target" "$widget_name"

  # Ensure import is present in Bar.qml
  local import_line="import \"../plugins/$target\""
  if ! grep -Fq "$import_line" "$BAR_QML"; then
    sed -i "4i $import_line" "$BAR_QML"
  fi

  # Ingest widget into Right Modules row if not present
  if ! grep -Fq "<$widget_name" "$BAR_QML" && ! grep -E -q "^\s*${widget_name}\s*\{" "$BAR_QML"; then
    # Insert before MiniPlayer
    sed -i "/MiniPlayer {/i \            ${widget_name} {\n                anchors.verticalCenter: parent.verticalCenter\n                bar: root\n            }\n" "$BAR_QML"
    printf 'Mounted %s in Bar.qml\n' "$widget_name"
  else
    printf '%s is already mounted in Bar.qml\n' "$widget_name"
  fi

  printf '✓ Plugin "%s" enabled successfully.\n' "$target"
  reload_quickshell
}

cmd_plugin_disable() {
  local target="$1"
  local plugin_dir="$PLUGINS_DIR/$target"
  local widget_name=""
  if [ -d "$plugin_dir" ]; then
    local manifest="$plugin_dir/manifest.json"
    if [ -f "$manifest" ]; then
      local widget_file
      widget_file=$(python3 -c "import json; print(json.load(open('$manifest')).get('entryPoints', {}).get('barWidget', ''))" 2>/dev/null || true)
      widget_name="${widget_file%.qml}"
    fi
  fi

  local import_line="import \"../plugins/$target\""
  sed -i "\|$import_line|d" "$BAR_QML" || true

  if [ -n "$widget_name" ]; then
    # Remove QML block for the widget
    python3 -c "
import re
path = '$BAR_QML'
with open(path, 'r') as f:
    c = f.read()
pattern = r'\n\s*${widget_name}\s*\{[^}]*\}\n'
new_c = re.sub(pattern, '\n', c)
with open(path, 'w') as f:
    f.write(new_c)
" 2>/dev/null || true
  fi

  printf '✓ Plugin "%s" disabled.\n' "$target"
  reload_quickshell
}

# --- Main Dispatcher ---
usage() {
  cat <<'EOF'
Usage: omarchy <domain> [command] [arguments]

Domains:
  plugin <add|list|enable|disable|remove>   Manage Quickshell plugins
  agent <default|run|crash>                 Manage default AI agent
  crash <list|reports|mute|toggle>          Inspect & diagnose crashes
  ledge <add|list|clear|toggle>             File ledge drop-zone controls
  help                                      Show this help message
EOF
}

main() {
  local domain="${1:-help}"
  if [ $# -gt 0 ]; then shift; fi

  case "$domain" in
    plugin|plugins)
      cmd_plugin "$@"
      ;;
    agent|agents)
      exec omarchy-agent "$@"
      ;;
    crash|crashes)
      exec omarchy-crash "$@"
      ;;
    ledge)
      exec omarchy-ledge "$@"
      ;;
    help|--help|-h)
      usage
      ;;
    *)
      # Fallback: check if an omarchy-<domain> command exists
      if command -v "omarchy-$domain" >/dev/null 2>&1; then
        exec "omarchy-$domain" "$@"
      else
        usage >&2
        exit 1
      fi
      ;;
  esac
}

main "$@"
