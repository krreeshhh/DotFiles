#!/usr/bin/env bash
# omarchy-agent - Default Agent Manager & Launcher

set -euo pipefail

CONFIG_FILE="$HOME/.config/omarchy/defaults/agent.json"
CRASH_DIR="$HOME/.local/state/crashes"

mkdir -p "$(dirname "$CONFIG_FILE")" "$CRASH_DIR"

get_config_val() {
  local key="$1"
  local fallback="$2"
  if [ -f "$CONFIG_FILE" ]; then
    python3 -c "import json; d=json.load(open('$CONFIG_FILE')); print(d.get('$key', '$fallback'))" 2>/dev/null || echo "$fallback"
  else
    echo "$fallback"
  fi
}

cmd_default() {
  if [ $# -eq 0 ]; then
    local current
    current=$(get_config_val "default_agent" "antigravity-cli")
    printf 'Default agent: %s\n' "$current"
    return 0
  fi

  local new_agent="$1"
  python3 -c "
import json, os
path = '$CONFIG_FILE'
os.makedirs(os.path.dirname(path), exist_ok=True)
try:
    d = json.load(open(path))
except Exception:
    d = {}
d['default_agent'] = '$new_agent'
if '$new_agent' in ['antigravity-cli', 'antigravity', 'agy']:
    d['command'] = 'agy'
    d['prompt_flag'] = '-i'
elif '$new_agent' in ['claude', 'claude-code']:
    d['command'] = 'claude'
    d['prompt_flag'] = '-p'
elif '$new_agent' in ['codex']:
    d['command'] = 'codex'
    d['prompt_flag'] = '-p'
json.dump(d, open(path, 'w'), indent=2)
"
  printf 'Default agent set to: %s\n' "$new_agent"
}

cmd_run() {
  local agent_cmd
  agent_cmd=$(get_config_val "command" "agy")
  local prompt_flag
  prompt_flag=$(get_config_val "prompt_flag" "-i")

  if [ $# -eq 0 ]; then
    if [ -t 0 ] && [ -t 1 ]; then
      exec "$agent_cmd"
    else
      exec ghostty --title="Agent - $agent_cmd" -e "$agent_cmd"
    fi
  else
    local prompt="$*"
    if [ -t 0 ] && [ -t 1 ]; then
      exec "$agent_cmd" "$prompt_flag" "$prompt"
    else
      exec ghostty --title="Agent - $agent_cmd" -e "$agent_cmd" "$prompt_flag" "$prompt"
    fi
  fi
}

cmd_crash() {
  local pid="${1:-}"
  if [ -z "$pid" ]; then
    # Pick the most recent crash from coredumpctl
    pid=$(coredumpctl list -n 1 --no-legend 2>/dev/null | awk '{print $5}' | head -n 1)
    if [ -z "$pid" ]; then
      printf 'omarchy-agent: no recent crash found in coredumpctl\n' >&2
      exit 1
    fi
  fi

  printf 'Preparing crash diagnosis for PID %s...\n' "$pid"
  
  # Check if report already generated by crash-watch or generate on the fly
  local report_file
  report_file=$(find "$CRASH_DIR" -name "*_${pid}.md" 2>/dev/null | head -n 1 || true)
  
  if [ -z "$report_file" ] || [ ! -f "$report_file" ]; then
    report_file="$CRASH_DIR/crash_$(date +%Y%m%d_%H%M%S)_pid${pid}.md"
    printf '# Crash Diagnostic Report for PID %s\n\n' "$pid" > "$report_file"
    printf 'Generated at: %s\n\n' "$(date)" >> "$report_file"
    printf '## coredumpctl info\n```text\n' >> "$report_file"
    coredumpctl info "$pid" >> "$report_file" 2>&1 || true
    printf '```\n\n## Recent Journal Logs\n```text\n' >> "$report_file"
    journalctl _PID="$pid" -n 50 --no-pager >> "$report_file" 2>&1 || true
    printf '```\n' >> "$report_file"
  fi

  local agent_cmd
  agent_cmd=$(get_config_val "command" "agy")
  local prompt_flag
  prompt_flag=$(get_config_val "prompt_flag" "-i")
  local prompt="I have a crash report for PID ${pid} located at ${report_file}. Please activate the diagnose-crash skill to analyze the stack trace and help resolve or fix this issue."

  printf 'Launching %s with crash report %s...\n' "$agent_cmd" "$report_file"

  if [ -t 0 ] && [ -t 1 ]; then
    exec "$agent_cmd" "$prompt_flag" "$prompt"
  else
    exec ghostty --title="Crash Diagnosis - Antigravity (PID $pid)" -e "$agent_cmd" "$prompt_flag" "$prompt"
  fi
}

usage() {
  cat <<'EOF'
Usage: omarchy-agent <command> [arguments]

Commands:
  run [prompt]           Launch the default agent (in terminal or GUI window)
  crash [pid]            Diagnose a crash report for the given PID (or latest crash)
  default [agent_name]   Get or set the default agent (e.g. antigravity-cli, claude)
  help                   Show this help message

Aliases:
  agent                  Alias for 'omarchy-agent run'
  a                      Inline terminal alias
EOF
}

main() {
  local sub="${1:-help}"
  if [ $# -gt 0 ]; then shift; fi

  case "$sub" in
    run)
      cmd_run "$@"
      ;;
    crash)
      cmd_crash "$@"
      ;;
    default)
      cmd_default "$@"
      ;;
    help|--help|-h)
      usage
      ;;
    *)
      # If unknown subcommand, treat arguments as a prompt to run
      cmd_run "$sub" "$@"
      ;;
  esac
}

main "$@"
